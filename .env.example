# Phase 0B does not load this file. Do not add credentials or secrets.
# For local `next dev`, prefer apps/cockpit/.env.example copied to
# apps/cockpit/.env.local, or export the same names in the WSL shell.
TRADING_MODE=PAPER

# First cockpit screen. PAPER only. No keys.
# Default: tests/fixtures/course1_cockpit/live-public-soak (run_id 20260904t001800z-live-paper)
# Later VPS: set the path-contract pair instead of COCKPIT_PAPER_RUN_DIR.
# COCKPIT_ARTIFACT_ROOT=/var/lib/hyperliquid-bot/reconstructable
# COCKPIT_RUN_ID=20260904t001800z-live-paper
# COCKPIT_PAPER_RUN_DIR=tests/fixtures/course1_cockpit/live-public-soak

# DATA-1A live capture on TerraPC WSL (read-only; do not stop collectors).
# Next.js does not load this root file. Export in the same WSL shell before
# `pnpm --filter @hyperliquid-bot/cockpit dev`, or use apps/cockpit/.env.local.
# Current TerraPC defaults: HL / Bitvavo / Kraken 20260905t232635z-live-retained;
# Binance 20260906t101559z-live-retained (do not prefer stopped
# 20260905t235830z-live-retained). Unset venue run_ids auto-detect live retains.
# ARTIFACT_ROOT=$HOME/hyperliquid-artifacts/reconstructable
