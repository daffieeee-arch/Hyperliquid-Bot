# Phase 0B does not load this file. Do not add credentials or secrets.
# For local `next dev`, prefer apps/cockpit/.env.example copied to
# apps/cockpit/.env.local, or export the same names in the VPS shell.
TRADING_MODE=PAPER

# First cockpit screen. PAPER only. No keys.
# Default: tests/fixtures/course1_cockpit/live-public-soak (run_id 20260904t001800z-live-paper)
# VPS path contract: set the pair instead of COCKPIT_PAPER_RUN_DIR.
# COCKPIT_ARTIFACT_ROOT=$HOME/Hyperliquid Project/data-capture
# COCKPIT_RUN_ID=20260904t001800z-live-paper
# COCKPIT_PAPER_RUN_DIR=tests/fixtures/course1_cockpit/live-public-soak

# DATA-1A live capture on the primary VPS (read-only; do not stop collectors).
# Next.js does not load this root file. Export in the same VPS shell before
# `pnpm --filter @hyperliquid-bot/cockpit dev`, or use apps/cockpit/.env.local.
# Leave venue run IDs unset to auto-detect the freshest live retain.
# ARTIFACT_ROOT=$HOME/Hyperliquid Project/data-capture
# Optional explicit overrides:
# DATA1A_RUN_ID=<run_id>
# DATA1E_RUN_ID=<run_id>
# DATA1B_RUN_ID=<run_id>
# DATA1F_RUN_ID=<run_id>
# Equivalent: COCKPIT_DATA1A_RUN_ID, or /?data1a_run_id=<run_id>
