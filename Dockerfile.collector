FROM ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 AS uv
FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/daffieeee-arch/Hyperliquid-Bot" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.description="Bounded credentialless PAPER market-data collector"
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    TRADING_MODE=PAPER TZ=UTC HOME=/tmp COLLECTOR_SOURCE_COMMIT=${SOURCE_COMMIT}
COPY --from=dependencies /opt/venv /opt/venv
COPY src /app/src
RUN test "${#SOURCE_COMMIT}" = 40 && \
    /usr/sbin/groupadd --gid 1000 collector && \
    /usr/sbin/useradd --uid 1000 --gid 1000 --no-create-home --home-dir /tmp collector
USER 1000:1000
WORKDIR /app
ENTRYPOINT ["python", "-B", "-m", "hyperliquid_bot.collector_runtime"]
