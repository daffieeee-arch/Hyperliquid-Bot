# Loaded only by the local Next.js cockpit (`apps/cockpit/.env.local` during
# `next dev`). Copy this file to `.env.local` in this directory, or export the
# same names in the WSL shell. Do not add credentials or secrets.
TRADING_MODE=PAPER

# COURSE-1 PAPER JSON (optional). Default: tests/fixtures/course1_cockpit/live-public-soak
# COCKPIT_ARTIFACT_ROOT=/var/lib/hyperliquid-bot/reconstructable
# COCKPIT_RUN_ID=20260904t001800z-live-paper

# DATA-1A reconstructable capture (read-only). Do not stop a running collector.
# Health JSON is written at stop; growing raw/part-*.parquet files and mtime are
# the live signal until then. The first PAPER screen polls /api/data1a-capture
# every 5 seconds (Cache-Control: no-store). Do not stop the collector to refresh.
#
# TerraPC WSL2 (current live retain; Linux filesystem, not /mnt/c):
# ARTIFACT_ROOT=/home/dmesdary/hyperliquid-artifacts/reconstructable
# DATA1A_RUN_ID=20260904t134940z-live-retained
#
# Equivalent run-id aliases: COCKPIT_DATA1A_RUN_ID, or
# http://127.0.0.1:3000/?data1a_run_id=20260904t134940z-live-retained
#
# Later VPS path-contract root (same file names):
# ARTIFACT_ROOT=/var/lib/hyperliquid-bot/reconstructable
# DATA1A_RUN_ID=20260904t134940z-live-retained
