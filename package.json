  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "format:check": "prettier --check .github/workflows/ci.yml eslint.config.mjs package.json pnpm-workspace.yaml prettier.config.mjs tsconfig.json vitest.config.ts tests/typescript/toolchain.test.ts",
